        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MakerLab" Width="1366" Height="768" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F1EC">
    <Grid>
        <TextBlock x:Name="Cargando" Text="Iniciando MakerLab…" FontSize="18" Foreground="#5B6475"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <wv2:WebView2 x:Name="Navegador" Visibility="Hidden" />
    </Grid>
</Window>
